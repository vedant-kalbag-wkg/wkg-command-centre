# ─────────────────────────────────────────────────────────────────────
# wkg-command-centre — local dev environment template
# Copy to .env.local and fill in only the values you need for what
# you're working on. Every key process.env.* in src/, scripts/, and
# tests/ is documented here; per-environment files (.env.test, .env.uat,
# Vercel preview/prod) inherit this same shape.
# ─────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────
# Neon pooled connection string for app + scripts.
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=verify-full

# ─── Auth (Better Auth) ──────────────────────────────────────────────
BETTER_AUTH_SECRET=<generate with: openssl rand -hex 32>
# Origin Better Auth signs against. On Vercel preview, MUST match the
# git-branch alias (CLAUDE.md note) — per-deploy hash URLs break on
# redeploy.
BETTER_AUTH_URL=http://localhost:3003

# ─── Email (Resend) ──────────────────────────────────────────────────
# Resend dashboard → API keys → key with "Sending" permission scoped to
# command.weknowgroup.com.
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@command.weknowgroup.com
EMAIL_REPLY_TO=
# Address shown in password-changed alert emails as the contact for
# unauthorised-change reports. Falls back to the project owner's address
# inside src/app/api/account/password-changed/route.ts.
ADMIN_SUPPORT_EMAIL=
# Recipient used by scripts/render-email-check.ts when sending a live
# Resend round-trip during email-template QA (no value → script no-ops).
EMAIL_PREVIEW_RECIPIENT=

# ─── Async (Inngest) ─────────────────────────────────────────────────
# Inngest dashboard → Manage → Event keys / Signing key. Local dev with
# Inngest dev server can leave both blank.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── AWS S3 (contract documents) ─────────────────────────────────────
AWS_S3_BUCKET=
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Public bucket name surfaced to the browser for direct contract-doc
# links from src/components/locations/contract-documents.tsx.
NEXT_PUBLIC_AWS_S3_BUCKET=

# ─── Azure Blob Storage (sales-data ETL source) ──────────────────────
# Account: wkgsalesdata · containers: clientdata (prod) / testdata (smoke).
# Either AZURE_STORAGE_CONNECTION_STRING (full conn-string auth) or
# AZURE_STORAGE_ACCOUNT_URL (managed-identity / SAS auth) must be set —
# see src/lib/sales/azure-client.ts for the precedence rules.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_BLOB_CONTAINER=clientdata

# Sales-data ETL endpoint guard. Both must be set for /api/etl/azure/run
# to accept a request — see src/app/api/etl/azure/run/route.ts.
ETL_AZURE_ENABLED=false
ETL_SHARED_SECRET=

# ─── Monday.com integration ──────────────────────────────────────────
MONDAY_API_TOKEN=
# Override read only by scripts/diagnose-new-board.ts (defaults to the
# baked-in board id otherwise). Leave unset unless re-running that
# diagnostic against a different board.
BOARD_ID=

# ─── Google Maps (geocoding for locations) ───────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── Seed script (npm run db:seed) ───────────────────────────────────
ADMIN_EMAIL=admin@weknow.co
ADMIN_NAME=
ADMIN_PASSWORD=<set a strong password>

# ─── E2E / Playwright test credentials ───────────────────────────────
# Required only when running the auth-flow E2E specs in tests/auth/*.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# ─── Playwright runtime knobs ────────────────────────────────────────
# When set, Playwright runs against this URL instead of starting the
# local dev server (used for preview-deploy UAT).
PLAYWRIGHT_BASE_URL=
# Guards for destructive E2E runs. All three must be explicitly opted in
# (`true` / `1`) — defaults are safe.
PLAYWRIGHT_DESTRUCTIVE=
PLAYWRIGHT_EXPECT_DUPES=
LOCAL_E2E_ALLOW_PASSWORD_ROTATE=

# ─── Phase 6 UAT seed IDs ────────────────────────────────────────────
# Playwright merge-undo specs read these to assert against known fixture
# rows in the UAT branch. No value → specs skip.
UAT_MERGE_AUDIT_ID=
UAT_UNDONE_MERGE_AUDIT_ID=

# ─── Telemetry toggles (off by default) ──────────────────────────────
# Set to any truthy value to log analytics-cache hit/miss to the server
# console (src/lib/analytics/cache-stats.ts).
LOG_CACHE_STATS=
